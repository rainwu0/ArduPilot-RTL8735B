# RTL8735B 通用板：只設定晶片周邊的腳位，不含感測器。
# 腳位依 HUB 8735 ultra 配置：序列埠、SPI、I²C、PWM、類比輸入在排針上；GPIO 7、25、26 沿用開發板的 D 編號（25、26 為板上 LED）。
# 感測器、安裝方向與預設參數以 ./waf configure --extra-hwdef 疊加。
define HAL_RTL8735B_BOARD_NAME "rtl8735b-empty"
# 匯流排、輸出與腳位（關鍵字見 hwdef/scripts/rtl8735b_hwdef.py；疊加檔以 undef <關鍵字> 清空整組再重寫）
RTL8735B_I2CBUS 1 1 PIN_F2 PIN_F1 400000 external
define HAL_RTL8735B_I2C_TIMEOUT_MS 4
RTL8735B_SPIBUS 1 1 PIN_F7 PIN_F5 PIN_F6 1000000
RTL8735B_SPIDEV bmi160 1 PIN_F8 0 1000000 10000000
define HAL_RTL8735B_SPI_TIMEOUT_MS 20
RTL8735B_RCOUT PIN_F14
RTL8735B_RCOUT PIN_F11
RTL8735B_RCOUT PIN_F12
RTL8735B_RCOUT PIN_F13
RTL8735B_ADC 2 PIN_F0
RTL8735B_GPIO 7 PIN_D17 in
RTL8735B_GPIO 25 PIN_E6 out
RTL8735B_GPIO 26 PIN_F9 out
define HAL_RTL8735B_SERIAL0_UART_ID 1
define HAL_RTL8735B_SERIAL0_TX_PIN PIN_F4
define HAL_RTL8735B_SERIAL0_RX_PIN PIN_F3
define HAL_RTL8735B_SERIAL0_ENABLED 0
define HAL_RTL8735B_SERIAL1_UART_ID 2
define HAL_RTL8735B_SERIAL1_TX_PIN PIN_D15
define HAL_RTL8735B_SERIAL1_RX_PIN PIN_D16
define HAL_RTL8735B_SERIAL1_ENABLED 1
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD 115
define HAL_RTL8735B_SERIAL2_UART_ID 255
define HAL_RTL8735B_SERIAL2_TX_PIN 0
define HAL_RTL8735B_SERIAL2_RX_PIN 0
define HAL_RTL8735B_SERIAL2_ENABLED 0
# Wi-Fi MAVLink 預設 UDP；改用 TCP server 時以 --extra-hwdef 加上 define HAL_RTL8735B_WIFI_TCP_PORT 5760
define HAL_RTL8735B_WIFI_SERIAL 2
define HAL_RTL8735B_WIFI_UDP_LOCAL_PORT 14555
define HAL_RTL8735B_WIFI_UDP_GCS_PORT 14550
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_MAVLink2
define HAL_RTL8735B_SERIAL3_UART_ID 0
define HAL_RTL8735B_SERIAL3_TX_PIN PIN_A2
define HAL_RTL8735B_SERIAL3_RX_PIN PIN_A3
define HAL_RTL8735B_SERIAL3_ENABLED 1
define HAL_RTL8735B_SERIAL4_UART_ID 3
define HAL_RTL8735B_SERIAL4_TX_PIN PIN_E1
define HAL_RTL8735B_SERIAL4_RX_PIN PIN_E2
define HAL_RTL8735B_SERIAL4_ENABLED 1
define HAL_RTL8735B_SERIAL5_UART_ID 255
define HAL_RTL8735B_SERIAL5_TX_PIN 0
define HAL_RTL8735B_SERIAL5_RX_PIN 0
define HAL_RTL8735B_SERIAL5_ENABLED 0
define HAL_RTL8735B_SERIAL6_UART_ID 255
define HAL_RTL8735B_SERIAL6_TX_PIN 0
define HAL_RTL8735B_SERIAL6_RX_PIN 0
define HAL_RTL8735B_SERIAL6_ENABLED 0
define HAL_RTL8735B_SERIAL7_UART_ID 255
define HAL_RTL8735B_SERIAL7_TX_PIN 0
define HAL_RTL8735B_SERIAL7_RX_PIN 0
define HAL_RTL8735B_SERIAL7_ENABLED 0
define HAL_RTL8735B_SERIAL8_UART_ID 255
define HAL_RTL8735B_SERIAL8_TX_PIN 0
define HAL_RTL8735B_SERIAL8_RX_PIN 0
define HAL_RTL8735B_SERIAL8_ENABLED 0
define HAL_RTL8735B_SERIAL9_UART_ID 255
define HAL_RTL8735B_SERIAL9_TX_PIN 0
define HAL_RTL8735B_SERIAL9_RX_PIN 0
define HAL_RTL8735B_SERIAL9_ENABLED 0
define AP_BARO_PROBE_EXTERNAL_I2C_BUSES 0
define AP_AIRSPEED_ENABLED 0
define HAL_LOGGING_FILESYSTEM_ENABLED 0
define HAL_LOGGING_DATAFLASH_ENABLED 0
define HAL_LOGGING_MAVLINK_ENABLED 1
define HAL_LOGGING_BACKENDS_DEFAULT 0
define AP_RCPROTOCOL_ENABLED 1
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_RCIN
define AP_SCRIPTING_ENABLED 0
define AP_TERRAIN_AVAILABLE 0
