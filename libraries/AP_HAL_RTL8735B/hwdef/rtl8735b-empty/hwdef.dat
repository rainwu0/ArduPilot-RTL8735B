define HAL_RTL8735B_GPIO_PIN25 PIN_E6
define HAL_RTL8735B_GPIO_PIN26 PIN_F9
define HAL_RTL8735B_SERIAL0_UART_ID 1
define HAL_RTL8735B_SERIAL0_TX_PIN PIN_F4
define HAL_RTL8735B_SERIAL0_RX_PIN PIN_F3
define HAL_RTL8735B_SERIAL0_ENABLED 0
define HAL_RTL8735B_SERIAL1_UART_ID 2
define HAL_RTL8735B_SERIAL1_TX_PIN PIN_D15
define HAL_RTL8735B_SERIAL1_RX_PIN PIN_D16
define HAL_RTL8735B_SERIAL1_ENABLED 1
