# RTL8735B 通用板：只設定晶片周邊的腳位，不含感測器。
# 感測器、安裝方向與預設參數以 ./waf configure --extra-hwdef 疊加。
define HAL_RTL8735B_BOARD_NAME "rtl8735b-empty"
define HAL_RTL8735B_I2C1_BUS_ID 1
define HAL_RTL8735B_I2C1_SDA_PIN PIN_F2
define HAL_RTL8735B_I2C1_SCL_PIN PIN_F1
define HAL_RTL8735B_I2C1_CLOCK_HZ 400000
define HAL_RTL8735B_I2C_TIMEOUT_MS 4
define HAL_RTL8735B_SPI1_BUS_ID 1
define HAL_RTL8735B_SPI1_MISO_PIN PIN_F5
define HAL_RTL8735B_SPI1_SCLK_PIN PIN_F6
define HAL_RTL8735B_SPI1_MOSI_PIN PIN_F7
define HAL_RTL8735B_BMI160_CS_PIN PIN_F8
define HAL_RTL8735B_SPI1_LOW_SPEED_HZ 1000000
define HAL_RTL8735B_SPI1_HIGH_SPEED_HZ 10000000
define HAL_RTL8735B_SPI_TIMEOUT_MS 20
define HAL_RTL8735B_RCOUT_CHANNELS 4
define HAL_RTL8735B_RCOUT_PIN0 PIN_F14
define HAL_RTL8735B_RCOUT_PIN1 PIN_F11
define HAL_RTL8735B_RCOUT_PIN2 PIN_F12
define HAL_RTL8735B_RCOUT_PIN3 PIN_F13
define HAL_RTL8735B_ADC_CHANNELS 1
